{
  "name": "@hosoodev/sae-builder",
  "version": "0.3.3",
  "type": "module",
  "description": "HTML-first SEO/AEO static site builder",
  "packageManager": "pnpm@10.34.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hosoodev/SAE-Builder.git"
  },
  "bugs": {
    "url": "https://github.com/hosoodev/SAE-Builder/issues"
  },
  "homepage": "https://github.com/hosoodev/SAE-Builder#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "sae": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "benchmark": "node --expose-gc --import tsx benchmarks/run.ts",
    "check": "tsc -p tsconfig.json --noEmit && tsx --test tests/**/*.test.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "clean": "node -e \"import('node:fs/promises').then(({rm}) => Promise.all(['dist','.builder-cache'].map((p) => rm(p,{recursive:true,force:true}))))\"",
    "release:pack": "npm run build && npm pack"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.0",
    "@tailwindcss/postcss": "^4.1.10",
    "esbuild": "^0.25.0",
    "gray-matter": "^4.0.3",
    "lightningcss": "^1.29.0",
    "parse5": "^7.3.0",
    "postcss": "^8.5.6",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "0.35.3",
    "tailwindcss": "^4.1.10",
    "unified": "^11.0.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
